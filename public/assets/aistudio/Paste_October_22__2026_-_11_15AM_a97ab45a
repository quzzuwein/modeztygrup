// =====================================================
// PROKON — Prisma Schema v2.2
// Tambahan v2.2:
//   - BANK RECONCILIATION (Rekonsiliasi Bank): BankReconciliation, BankReconciliationItem
// Tambahan v2.1:
//   - ATTACHMENT (lampiran/bukti transaksi): Attachment
// Tambahan v2.0:
//   - SUPPLIER BILL (AP/Hutang): SupplierBill, SupplierBillItem, SupplierPayment
// Tambahan v1.9 (sudah ada):
//   - INVOICE (AR/Piutang) ke Client: Invoice, InvoiceItem, InvoicePayment
// Tambahan v1.8 (sudah ada):
//   - PriceRegion.projectId (nullable) → HSD Lokal per project
//   - AhsTemplate.projectId (nullable) → AHS Project per project
// =====================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ORGANIZATION & COMPANY
// =====================================================

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  taxId     String?  @map("tax_id")
  address   String?
  phone     String?
  email     String?
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies Company[]

  @@map("organizations")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @unique
  name           String
  legalName      String?  @map("legal_name")
  taxId          String?  @map("tax_id")
  address        String?
  phone          String?
  email          String?
  logoUrl        String?  @map("logo_url")
  isMain         Boolean  @default(false) @map("is_main")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization            @relation(fields: [organizationId], references: [id])
  userRoles           UserRole[]
  userScopes          UserCompanyScope[]
  projects            Project[]
  requests            PurchaseRequest[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  warehouses          Warehouse[]
  receivings          Receiving[]
  consumptions        Consumption[]
  progresses          Progress[]
  chartOfAccounts     ChartOfAccount[]
  journals            Journal[]
  clients             Client[]
  ahsTemplates        AhsTemplate[]
  materials           Material[]
  labors              Labor[]
  equipments          Equipment[]
  priceRegions        PriceRegion[]
  userAssignments     UserAssignmentHistory[]
  cashAccounts        CashAccount[]
  cashTransactions    CashTransaction[]
  fundRequests        FundRequest[]
  documentDivisions   DocumentDivision[]
  documentCounters    DocumentCounter[]
  approvalRequests    ApprovalRequest[]
  invoices            Invoice[]
  supplierBills       SupplierBill[]
  supplierPayments    SupplierPayment[]
  accountingPeriods   AccountingPeriod[]
  attachments         Attachment[]
  bankReconciliations BankReconciliation[]
  projectBaselines    ProjectBaseline[]
  progressSnapshots   ProgressSnapshot[]
  workers             Worker[]
  attendances         Attendance[]
  payrollSubmissions PayrollSubmission[]

  subcontractors        Subcontractor[]
  revenueRecognitions  RevenueRecognition[]
  subcontractWorkOrders SubcontractWorkOrder[]
  spkTemplates SpkTemplate[]
  pphPayments PphPayment[]
  subcontractOpnames    SubcontractOpname[]
  stockOpnames        StockOpname[]
  materialTransfers   MaterialTransfer[]

  @@map("companies")

  dailyReports       DailyReport[]
  cashAdvances       CashAdvance[]
  cashAdvanceLpjs    CashAdvanceLpj[]
  ahsHeaders AhsHeader[]
}

// =====================================================
// CLIENT
// =====================================================

enum ClientType {
  SWASTA
  PEMERINTAH
  BUMN
  PERORANGAN
  LAINNYA
}

model Client {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  code          String
  name          String
  type          ClientType @default(SWASTA)
  taxId         String?    @map("tax_id")
  address       String?
  phone         String?
  email         String?
  contactPerson String?    @map("contact_person")
  notes         String?
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  projects Project[]
  invoices Invoice[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("clients")
}

// =====================================================
// USER
// =====================================================

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  passwordHash   String     @map("password_hash")
  fullName       String     @map("full_name")
  phone          String?
  position       String?
  employeeId     String?    @map("employee_id")
  address        String?
  emergencyPhone String?    @map("emergency_phone")
  avatarUrl      String?    @map("avatar_url")
  status         UserStatus @default(ACTIVE)
  is2faEnabled   Boolean    @default(false) @map("is_2fa_enabled")
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  userRoles               UserRole[]
  companyScopes           UserCompanyScope[]
  projectScopes           UserProjectScope[]
  sessions                UserSession[]
  auditLogs               AuditLog[]
  requestedRequests       PurchaseRequest[]       @relation("RequestRequester")
  verifiedRequests        PurchaseRequest[]       @relation("RequestVerifier")
  approvedRequests        PurchaseRequest[]       @relation("RequestApprover")
  userPermissions         UserPermission[]
  sowItems                UserSowItem[]
  assignmentHistories     UserAssignmentHistory[] @relation("AssignmentUser")
  handoverAssignments     UserAssignmentHistory[] @relation("AssignmentHandoverTo")
  statusHistories         UserStatusHistory[]     @relation("StatusUser")
  statusChanges           UserStatusHistory[]     @relation("StatusChangedBy")
  createdCashTransactions CashTransaction[]       @relation("CashTransactionCreatedBy")
  requestedFundRequests   FundRequest[]           @relation("FundRequester")
  approvedFundRequests    FundRequest[]           @relation("FundApprover")
  approvalSubmissions     ApprovalRequest[]       @relation("ApprovalSubmitter")
  approvalActions         ApprovalStep[]          @relation("ApprovalApprover")
  delegationsFrom         ApprovalDelegation[]    @relation("DelegationFrom")
  delegationsTo           ApprovalDelegation[]    @relation("DelegationTo")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TRANSFERRED
  RESIGNED
  TERMINATED
  RETIRED
}

// =====================================================
// SOW
// =====================================================

model UserSowItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  output    String?
  notes     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sow_items")
}

// =====================================================
// USER ASSIGNMENT HISTORY
// =====================================================

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  RESIGNED
  ON_LEAVE
}

model UserAssignmentHistory {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  companyId        String?          @map("company_id") @db.Uuid
  projectId        String?          @map("project_id") @db.Uuid
  roleCode         String           @map("role_code")
  startDate        DateTime         @default(now()) @map("start_date")
  endDate          DateTime?        @map("end_date")
  status           AssignmentStatus @default(ACTIVE)
  reason           String?
  handoverToUserId String?          @map("handover_to_user_id") @db.Uuid
  handoverNotes    String?          @map("handover_notes")
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user       User     @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  handoverTo User?    @relation("AssignmentHandoverTo", fields: [handoverToUserId], references: [id])
  company    Company? @relation(fields: [companyId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("user_assignment_histories")
}

// =====================================================
// USER STATUS HISTORY
// =====================================================

model UserStatusHistory {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  fromStatus    UserStatus @map("from_status")
  toStatus      UserStatus @map("to_status")
  reason        String?
  effectiveDate DateTime   @map("effective_date")
  changedById   String?    @map("changed_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")

  user      User  @relation("StatusUser", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([userId])
  @@map("user_status_histories")
}

// =====================================================
// ROLE & PERMISSION
// =====================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  granted      Boolean  @default(true)
  reason       String?
  grantedById  String?  @map("granted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// =====================================================
// USER ROLE & SCOPE
// =====================================================

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  @@unique([userId, roleId, companyId])
  @@map("user_roles")
}

model UserCompanyScope {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_company_scopes")
}

model UserProjectScope {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("user_project_scopes")
}

// =====================================================
// SESSION
// =====================================================

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// =====================================================
// AUDIT LOG
// =====================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  action     String
  entity     String
  entityId   String?  @map("entity_id") @db.Uuid
  beforeData Json?    @map("before_data") @db.JsonB
  afterData  Json?    @map("after_data") @db.JsonB
  reason     String?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================================================
// PROJECT
// =====================================================

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  clientId      String?       @map("client_id") @db.Uuid
  code          String
  shortCode     String?       @map("short_code")
  name          String
  description   String?
  location      String?
  contractValue Decimal       @default(0) @map("contract_value") @db.Decimal(20, 2)
  currency      String        @default("IDR")
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  targetProfit  Decimal?      @map("target_profit") @db.Decimal(20, 2)
  defaultTargetProfitPercent Decimal  @default(25.00) @map("default_target_profit_percent") @db.Decimal(5, 2)
    // ===== Pengaturan Pajak (Batch 9.6) =====
  isTaxable           Boolean @default(true)  @map("is_taxable")
  ppnEnabled          Boolean @default(true)  @map("ppn_enabled")
  ppnPercent          Decimal @default(11.00) @map("ppn_percent") @db.Decimal(5, 2)
  pphFinalEnabled     Boolean @default(true)  @map("pph_final_enabled")
  pphFinalType        String? @map("pph_final_type")
  pphFinalPercent     Decimal @default(2.65)  @map("pph_final_percent") @db.Decimal(5, 2)
  taxNotes            String? @map("tax_notes")
  status        ProjectStatus @default(DRAFT)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  company           Company                 @relation(fields: [companyId], references: [id])
  client            Client?                 @relation(fields: [clientId], references: [id])
  wbsNodes          WbsNode[]
  userScopes        UserProjectScope[]
  rabs              Rab[]
  raps              Rap[]
  requests          PurchaseRequest[]
  purchaseOrders    PurchaseOrder[]
  receivings        Receiving[]
  consumptions      Consumption[]
  progresses        Progress[]
  userAssignments   UserAssignmentHistory[]
  cashAccounts      CashAccount[]
  cashTransactions  CashTransaction[]
  fundRequests      FundRequest[]
  documentCounters  DocumentCounter[]
  approvalRequests  ApprovalRequest[]
  priceRegions      PriceRegion[]
  ahsTemplates      AhsTemplate[]
  invoices          Invoice[]
  supplierBills     SupplierBill[]
  projectBaselines  ProjectBaseline[]
  progressSnapshots ProgressSnapshot[]
  workers           Worker[]
  attendances       Attendance[]
  payrollSubmissions PayrollSubmission[]

    subcontractWorkOrders SubcontractWorkOrder[]
    revenueRecognitions   RevenueRecognition[]
    spkTemplates SpkTemplate[]
  subcontractOpnames    SubcontractOpname[]
  stockOpnames        StockOpname[]
  materialTransfers   MaterialTransfer[]

  @@unique([companyId, code])
  @@map("projects")

  dailyReports       DailyReport[]
  cashAdvances       CashAdvance[]
  cashAdvanceLpjs    CashAdvanceLpj[]
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// =====================================================
// WBS
// =====================================================

model WbsNode {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        WbsNode?              @relation("WbsHierarchy", fields: [parentId], references: [id])
  children      WbsNode[]             @relation("WbsHierarchy")
  rabItems      RabItem[]
  rapItems      RapItem[]
  progressItems ProgressItem[]
  baselineItems ProjectBaselineItem[]
  subcontractWorkOrderItems SubcontractWorkOrderItem[]

  

  @@unique([projectId, code])
  @@index([projectId])
  @@index([parentId])
  @@map("wbs_nodes")
}

// =====================================================
// MASTER MATERIAL, UPAH, EQUIPMENT
// =====================================================

model Material {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  unit      String
  category  String?
  spec      String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  prices           MaterialPrice[]
  ahsTemplateItems AhsTemplateItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([category])
  @@map("materials")
}

model Labor {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  unit      String   @default("OH")
  skill     String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  prices           LaborPrice[]
  ahsTemplateItems AhsTemplateItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([skill])
  @@map("labors")
}

model Equipment {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  unit      String
  category  String?
  spec      String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id])
  prices           EquipmentPrice[]
  ahsTemplateItems AhsTemplateItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([category])
  @@map("equipments")
}

// =====================================================
// BANK HARGA WILAYAH / HSD LOKAL PROJECT
// =====================================================

enum PriceStatus {
  ACTIVE
  PENDING
}

model PriceRegion {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  projectId String?  @map("project_id") @db.Uuid
  code      String?
  name      String
  province  String?
  year      Int
  source    String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  materialPrices  MaterialPrice[]
  laborPrices     LaborPrice[]
  equipmentPrices EquipmentPrice[]

  @@index([companyId])
  @@index([companyId, year])
  @@index([projectId])
  @@map("price_regions")
}

model MaterialPrice {
  id           String      @id @default(uuid()) @db.Uuid
  regionId     String      @map("region_id") @db.Uuid
  materialId   String?     @map("material_id") @db.Uuid
  materialCode String?     @map("material_code")
  materialName String      @map("material_name")
  unit         String
  price        Decimal     @db.Decimal(20, 2)
  category     String?
  status       PriceStatus @default(PENDING)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  region   PriceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  material Material?   @relation(fields: [materialId], references: [id])

  @@index([regionId])
  @@index([materialId])
  @@index([status])
  @@map("material_prices")
}

model LaborPrice {
  id        String      @id @default(uuid()) @db.Uuid
  regionId  String      @map("region_id") @db.Uuid
  laborId   String?     @map("labor_id") @db.Uuid
  laborCode String?     @map("labor_code")
  laborName String      @map("labor_name")
  unit      String
  price     Decimal     @db.Decimal(20, 2)
  skill     String?
  status    PriceStatus @default(PENDING)
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  region PriceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  labor  Labor?      @relation(fields: [laborId], references: [id])

  @@index([regionId])
  @@index([laborId])
  @@index([status])
  @@map("labor_prices")
}

model EquipmentPrice {
  id            String      @id @default(uuid()) @db.Uuid
  regionId      String      @map("region_id") @db.Uuid
  equipmentId   String?     @map("equipment_id") @db.Uuid
  equipmentCode String?     @map("equipment_code")
  equipmentName String      @map("equipment_name")
  unit          String
  price         Decimal     @db.Decimal(20, 2)
  category      String?
  status        PriceStatus @default(PENDING)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  region    PriceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  equipment Equipment?  @relation(fields: [equipmentId], references: [id])

  @@index([regionId])
  @@index([equipmentId])
  @@index([status])
  @@map("equipment_prices")
}

// =====================================================
// AHS TEMPLATE — FORMAT PUPR
// =====================================================

enum AhsItemCategory {
  TENAGA
  BAHAN
  ALAT
  SUBKON
}

model AhsTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  code            String
  name            String
  unit            String
  category        String?
  description     String?
  source          String?
  overheadPercent Decimal  @default(1) @map("overhead_percent") @db.Decimal(5, 2)
