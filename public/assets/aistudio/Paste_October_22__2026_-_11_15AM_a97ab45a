// =====================================================
// PROJECT BASELINE — Kurva S (v2.3 BARU)
// =====================================================
//
// ProjectBaseline = header jadwal rencana per proyek
// ProjectBaselineItem = jadwal per item RAB (minggu mulai/selesai)
//
// Alur:
// 1. RAB di-ACTIVATE → auto-create ProjectBaseline (DRAFT)
// 2. User isi jadwal per item (weekStart, weekEnd)
// 3. Sistem hitung baseline kumulatif dari bobot item
// 4. Progress VERIFIED → rebuild ProgressSnapshot
// 5. Frontend tampilkan grafik 3 garis
//
// =====================================================

model ProjectBaseline {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  rabId         String    @map("rab_id") @db.Uuid
  status        String    @default("DRAFT") // DRAFT | ACTIVE | SUPERSEDED | CANCELLED
  weekStartDate DateTime  @map("week_start_date") // Senin minggu pertama
  totalWeeks    Int       @map("total_weeks") // total minggu proyek
  notes         String?
  createdById   String?   @map("created_by_id") @db.Uuid
  activatedAt   DateTime? @map("activated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company         Company               @relation(fields: [companyId], references: [id])
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rab             Rab                   @relation(fields: [rabId], references: [id])
  items           ProjectBaselineItem[]

  @@unique([projectId, rabId])
  @@index([projectId])
  @@index([status])
  @@map("project_baselines")
}

model ProjectBaselineItem {
  id               String   @id @default(uuid()) @db.Uuid
  baselineId       String   @map("baseline_id") @db.Uuid
  rabItemId        String   @map("rab_item_id") @db.Uuid
  code             String
  name             String
  bobotPercent     Decimal  @map("bobot_percent") @db.Decimal(7, 4) // % dari total RAB
  weekStart        Int      @map("week_start") // minggu mulai (1, 2, 3...)
  weekEnd          Int      @map("week_end") // minggu selesai
  distributeLinear Boolean  @default(true) @map("distribute_linear")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  baseline  ProjectBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  rabItem   RabItem         @relation(fields: [rabItemId], references: [id])
  wbsNode   WbsNode?        @relation(fields: [wbsNodeId], references: [id])
  wbsNodeId String?         @db.Uuid

  @@unique([baselineId, rabItemId])
  @@index([baselineId])
  @@map("project_baseline_items")
}

// =====================================================
// PROGRESS SNAPSHOT — Cache Kurva S per Minggu
// =====================================================

model ProgressSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  weekNumber    Int      @map("week_number")
