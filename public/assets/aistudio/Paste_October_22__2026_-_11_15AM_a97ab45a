  transferDate       DateTime               @default(now()) @map("transfer_date")
  status             MaterialTransferStatus @default(DRAFT)
  notes              String?
  createdById        String?                @map("created_by_id") @db.Uuid
  receivedById       String?                @map("received_by_id") @db.Uuid
  submittedAt        DateTime?              @map("submitted_at")
  receivedAt         DateTime?              @map("received_at")
  cancelledAt        DateTime?              @map("cancelled_at")
  cancellationReason String?                @map("cancellation_reason")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  company       Company                @relation(fields: [companyId], references: [id])
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse              @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse              @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         MaterialTransferItem[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("material_transfers")
}

model MaterialTransferItem {
  id           String   @id @default(uuid()) @db.Uuid
  transferId   String   @map("transfer_id") @db.Uuid
  materialCode String   @map("material_code")
  materialName String   @map("material_name")
  unit         String
  quantity     Decimal  @db.Decimal(20, 4)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(20, 2)
  totalPrice   Decimal  @default(0) @map("total_price") @db.Decimal(20, 2)
  notes        String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transfer MaterialTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("material_transfer_items")
}
// =====================================================
// MASTER AHS (Analisa Harga Satuan)
// =====================================================

model AhsHeader {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String?        @db.Uuid
  code        String?
  name        String
  unit        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company     Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  components  AhsComponent[]

  @@index([companyId])
  @@index([name])
}
model AhsComponent {
  id            String    @id @default(uuid()) @db.Uuid
  ahsHeaderId   String    @db.Uuid
  componentType String
  name          String
  coefficient   Decimal   @db.Decimal(12, 6)
  unit          String?
  orderIndex    Int       @default(0)
  createdAt     DateTime  @default(now())

  ahsHeader     AhsHeader @relation(fields: [ahsHeaderId], references: [id], onDelete: Cascade)

  @@index([ahsHeaderId])
}