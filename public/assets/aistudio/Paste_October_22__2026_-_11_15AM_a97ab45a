  deviationPercent Decimal  @default(0) @map("deviation_percent") @db.Decimal(7, 4)
  forecastPercent  Decimal? @map("forecast_percent") @db.Decimal(7, 4)

  // Metadata
  lastProgressId String?  @map("last_progress_id") @db.Uuid
  generatedAt    DateTime @default(now()) @map("generated_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id])
